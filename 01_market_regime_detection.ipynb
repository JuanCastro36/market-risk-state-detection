# The paper uses 1985-2016. Here the end date is updated to the current date.
START_DATE = "1985-01-02"
END_DATE = (date.today() + timedelta(days=1)).isoformat()

PRICE_FILE = DATA_DIR / "historical_adjusted_close.csv"
RETURNS_FILE = DATA_DIR / "log_returns.csv"


# ============================================================
# Model parameters
# ============================================================

WINDOW = 20
STEP = 10
POWER_EPSILON = 0.6

# The paper reports 4 states for the USA market.
N_MARKET_STATES = 3

# Practical filter because some historical tickers may have incomplete Yahoo data.
MIN_COVERAGE = 0.90

# Number of K-Means runs used to evaluate cluster stability.
N_KMEANS_RUNS = 500

# Rolling probability window. With STEP=10, 10 epochs are about 100-110 trading days.
PROBABILITY_WINDOW = 10


# ============================================================
# Stock universe
# ============================================================

