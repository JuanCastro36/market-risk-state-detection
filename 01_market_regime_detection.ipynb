def apply_power_map(corr_matrix, epsilon=POWER_EPSILON):
    """
    Apply the Power Map transformation.

    C_ij -> sign(C_ij) * |C_ij|^(1 + epsilon)
    """

    values = corr_matrix.values.astype(float)
    transformed_values = np.sign(values) * (np.abs(values) ** (1.0 + epsilon))

    transformed = pd.DataFrame(
        transformed_values,
        index=corr_matrix.index,
        columns=corr_matrix.columns
    )

    np.fill_diagonal(transformed.values, 1.0)

    return transformed


def transform_all_epochs_with_power_map(epochs, epsilon=POWER_EPSILON):
    """
    Apply Power Map to all epoch correlation matrices.
    """

    transformed_epochs = {}

    for end_date, corr_matrix in epochs.items():
        transformed_epochs[end_date] = apply_power_map(
            corr_matrix=corr_matrix,
            epsilon=epsilon
        )

    first_date = sorted(transformed_epochs.keys())[0]
    transformed_epochs[first_date].to_csv(OUTPUT_DIR / "example_power_map_matrix.csv")

    print(f"Applied Power Map with epsilon = {epsilon}")

    return transformed_epochs


