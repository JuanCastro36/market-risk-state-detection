def calculate_rolling_state_probabilities(
    classified_states,
    probability_window=PROBABILITY_WINDOW
):
    """
    Calculate rolling probabilities of each market state.
    """

    state_labels = sorted(
        classified_states["state_label"].unique(),
        key=lambda x: int(x.replace("S", ""))
    )

    sequence = classified_states["state_label"].tolist()
    dates = classified_states.index

    probability_records = []

    for i in range(len(sequence)):
        start = max(0, i - probability_window + 1)
        local_window = sequence[start:i + 1]

        counts = pd.Series(local_window).value_counts(normalize=True)

        record = {"date": dates[i]}

        for state in state_labels:
            record[state] = counts.get(state, 0.0)

        probability_records.append(record)

    probabilities = pd.DataFrame(probability_records).set_index("date")
    probabilities.to_csv(OUTPUT_DIR / "rolling_state_probabilities.csv")

    return probabilities


