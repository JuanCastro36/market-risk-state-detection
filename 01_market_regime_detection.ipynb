def download_single_ticker(ticker, start_date, end_date):
    """
    Download one adjusted closing price series from Yahoo Finance.

    With auto_adjust=True, the Close column behaves as an adjusted close series.
    """

    data = yf.download(
        ticker,
        start=start_date,
        end=end_date,
        auto_adjust=True,
        progress=False
    )

    if data.empty:
        return None

    close = data["Close"]

    # Some yfinance versions may return a DataFrame instead of a Series.
    if isinstance(close, pd.DataFrame):
        close = close.iloc[:, 0]

    close.name = ticker

    return close


def download_price_data(tickers, start_date, end_date):
    """
    Download adjusted closing prices for several tickers.
    """

    price_series = []

    for ticker in tqdm(tickers, desc="Downloading prices"):
        try:
            close = download_single_ticker(
                ticker=ticker,
                start_date=start_date,
                end_date=end_date
            )

            if close is not None:
                price_series.append(close)
            else:
                print(f"Warning: no data found for {ticker}")

        except Exception as error:
            print(f"Error downloading {ticker}: {error}")

    if len(price_series) == 0:
        raise ValueError("No price series were downloaded.")

    prices = pd.concat(price_series, axis=1)
    prices.index.name = "Date"
    prices = prices.sort_index()

    return prices


def load_or_download_prices(
    tickers,
    price_file=PRICE_FILE,
    start_date=START_DATE,
    end_date=END_DATE,
    force_download=False
):
    """
    Load prices from a CSV file or download them from Yahoo Finance.
    """

    if price_file.exists() and not force_download:
        prices = pd.read_csv(price_file, index_col="Date", parse_dates=True)
        print(f"Loaded cached prices from {price_file}")
        return prices

    prices = download_price_data(
        tickers=tickers,
        start_date=start_date,
        end_date=end_date
    )

    prices.to_csv(price_file)
    print(f"Saved raw prices to {price_file}")

    return prices


def filter_assets_by_coverage(prices, min_coverage=MIN_COVERAGE):
    """
    Keep assets with enough non-missing observations.
    """

    coverage = prices.notna().mean()
    selected_tickers = coverage[coverage >= min_coverage].index.tolist()

    filtered_prices = prices[selected_tickers].copy()

    print(f"Original number of assets: {prices.shape[1]}")
    print(f"Selected number of assets: {filtered_prices.shape[1]}")

    if filtered_prices.shape[1] < 2:
        raise ValueError("At least two assets are required to compute correlations.")

    return filtered_prices


def clean_price_matrix(prices):
    """
    Clean the price matrix before computing log returns.

    Short missing gaps are forward-filled.
    Remaining incomplete rows are removed.
    """

    clean_prices = prices.copy()

    clean_prices = clean_prices.dropna(axis=1, how="all")
    clean_prices = clean_prices.ffill(limit=5)
    clean_prices = clean_prices.dropna(axis=0, how="any")

    # Log returns require strictly positive prices.
    positive_columns = (clean_prices > 0).all(axis=0)
    clean_prices = clean_prices.loc[:, positive_columns]

    print(f"Final price matrix shape: {clean_prices.shape}")
    print(f"Final date range: {clean_prices.index.min().date()} to {clean_prices.index.max().date()}")

    if clean_prices.shape[1] < 2:
        raise ValueError("At least two valid price series are required.")

    return clean_prices


def prepare_price_data(force_download=False):
    """
    Complete price preparation pipeline.
    """

    raw_prices = load_or_download_prices(
        tickers=TICKERS,
        price_file=PRICE_FILE,
        start_date=START_DATE,
        end_date=END_DATE,
        force_download=force_download
    )

    filtered_prices = filter_assets_by_coverage(
        prices=raw_prices,
        min_coverage=MIN_COVERAGE
    )

    clean_prices = clean_price_matrix(filtered_prices)
    clean_prices.to_csv(DATA_DIR / "clean_adjusted_close.csv")

    return clean_prices

def calculate_log_returns(price_data):
    """
    Calculate daily logarithmic returns.

    r_k(t) = log(P_k(t)) - log(P_k(t-1))
    """

    log_returns = np.log(price_data).diff()
    log_returns = log_returns.dropna(axis=0, how="any")

    log_returns.to_csv(RETURNS_FILE)

    print(f"Log returns shape: {log_returns.shape}")
    print(f"Saved log returns to {RETURNS_FILE}")

    return log_returns


def get_off_diagonal_values(matrix):
    """
    Extract the off-diagonal values of a square matrix.
    """

    values = np.asarray(matrix, dtype=float)

    if values.shape[0] != values.shape[1]:
        raise ValueError("The input matrix must be square.")

    off_diagonal_mask = ~np.eye(values.shape[0], dtype=bool)

    return values[off_diagonal_mask]


def calculate_mean_correlation(corr_matrix):
    """
    Calculate the average market correlation.

    The diagonal is excluded because it is always equal to 1.
    """

    off_diagonal_values = get_off_diagonal_values(corr_matrix)
    off_diagonal_values = off_diagonal_values[np.isfinite(off_diagonal_values)]

    if len(off_diagonal_values) == 0:
        return np.nan

    return np.mean(off_diagonal_values)


def calculate_gini_coefficient(values):
    """
    Calculate the Gini coefficient of a numeric array.

    The implementation follows the mean absolute difference definition.
    """

    x = np.asarray(values, dtype=float)
    x = x[np.isfinite(x)]

    if len(x) == 0:
        return np.nan

    mean_x = np.mean(x)

    if mean_x == 0:
        return np.nan

    mean_absolute_difference = np.abs(np.subtract.outer(x, x)).mean()
    relative_mean_absolute_difference = mean_absolute_difference / mean_x

    return 0.5 * relative_mean_absolute_difference


def calculate_correlation_gini(corr_matrix):
    """
    Calculate the Gini coefficient of absolute off-diagonal correlations.

    Absolute values are used because the goal is to measure inequality
    in correlation magnitudes, not the sign of correlations.
    """

    off_diagonal_values = get_off_diagonal_values(corr_matrix)
    absolute_correlations = np.abs(off_diagonal_values)

    return calculate_gini_coefficient(absolute_correlations)


def calculate_epoch_correlation(epoch_returns):
    """
    Calculate the Pearson correlation matrix for one return epoch.
    """

    corr_matrix = epoch_returns.corr()
    corr_matrix = corr_matrix.replace([np.inf, -np.inf], np.nan)

    if corr_matrix.isna().sum().sum() > 0:
        return None

    corr_matrix = corr_matrix.clip(lower=-1.0, upper=1.0)
    np.fill_diagonal(corr_matrix.values, 1.0)

    return corr_matrix


def generate_epoch_indices(log_returns, window=WINDOW, step=STEP):
    """
    Generate the final index of each rolling epoch.
    """

    return list(range(window - 1, len(log_returns), step))


def extract_epoch_returns(log_returns, end_index, window=WINDOW):
    """
    Extract the return matrix corresponding to one rolling epoch.
    """

    start_index = end_index - window + 1
    epoch_returns = log_returns.iloc[start_index:end_index + 1]

    return epoch_returns


def build_correlation_epochs(log_returns, window=WINDOW, step=STEP):
    """
    Build short-time correlation matrices and epoch-level metrics.

    Returns
    -------
    epochs : dict
        Dictionary whose keys are epoch end dates and whose values are
        correlation matrices.

    epoch_metrics : pd.DataFrame
        Table with average return, mean correlation and Gini coefficient
        for each epoch.
    """

    epochs = {}
    records = []

    epoch_indices = generate_epoch_indices(
        log_returns=log_returns,
        window=window,
        step=step
    )

    for end_index in tqdm(epoch_indices, desc="Building correlation epochs"):
        epoch_returns = extract_epoch_returns(
            log_returns=log_returns,
            end_index=end_index,
            window=window
        )

        end_date = epoch_returns.index[-1]
        start_date = epoch_returns.index[0]

        corr_matrix = calculate_epoch_correlation(epoch_returns)

        if corr_matrix is None:
            continue

        average_return = epoch_returns.mean().mean()
        mean_correlation = calculate_mean_correlation(corr_matrix)
        gini_correlation = calculate_correlation_gini(corr_matrix)

        epochs[end_date] = corr_matrix

        records.append({
            "end_date": end_date,
            "start_date": start_date,
            "average_return": average_return,
            "mean_correlation": mean_correlation,
            "correlation_gini": gini_correlation
        })

    epoch_metrics = pd.DataFrame(records).set_index("end_date")
    epoch_metrics.to_csv(OUTPUT_DIR / "epoch_metrics.csv")

    print(f"Number of valid epochs: {len(epochs)}")
    print(f"Saved epoch metrics to {OUTPUT_DIR / 'epoch_metrics.csv'}")

    return epochs, epoch_metrics

def calculate_global_correlation_matrix(log_returns):
    """
    Calculate the full-period correlation matrix of log returns.
    """

    global_corr = log_returns.corr()
    global_corr.to_csv(OUTPUT_DIR / "global_correlation_matrix.csv")

    return global_corr


