def build_project_summary(
    prices,
    log_returns,
    epochs,
    classified_states,
    state_summary,
    transition_matrix,
    markov_comparison
):
    """
    Build a compact summary table for the GitHub README.
    """

    summary = {
        "start_date": str(prices.index.min().date()),
        "end_date": str(prices.index.max().date()),
        "number_of_assets": int(prices.shape[1]),
        "number_of_price_observations": int(prices.shape[0]),
        "number_of_return_observations": int(log_returns.shape[0]),
        "number_of_epochs": int(len(epochs)),
        "window_days": WINDOW,
        "step_days": STEP,
        "power_map_epsilon": POWER_EPSILON,
        "number_of_market_states": N_MARKET_STATES,
        "most_frequent_state": classified_states["state_label"].value_counts().idxmax()
    }

    summary_df = pd.DataFrame([summary])
    summary_df.to_csv(OUTPUT_DIR / "project_summary.csv", index=False)

    state_summary.to_csv(OUTPUT_DIR / "final_state_summary.csv")
    transition_matrix.to_csv(OUTPUT_DIR / "final_transition_matrix.csv")
    markov_comparison.to_csv(OUTPUT_DIR / "final_markov_comparison.csv")

    print("Project summary:")
    for key, value in summary.items():
        print(f"- {key}: {value}")

    return summary_df

