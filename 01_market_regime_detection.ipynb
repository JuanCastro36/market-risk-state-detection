    print(f"Saved figure: {path}")

    return transformed

def calculate_zeta_between_matrices(matrix_a, matrix_b, include_diagonal=True):
    """
    Calculate zeta distance between two correlation matrices.

    zeta(tau_a, tau_b) = average |C_ij(tau_a) - C_ij(tau_b)|
    """

    values_a = matrix_a.values.astype(float)
    values_b = matrix_b.values.astype(float)

    difference = np.abs(values_a - values_b)

    if include_diagonal:
        return np.nanmean(difference)

    mask = ~np.eye(difference.shape[0], dtype=bool)

    return np.nanmean(difference[mask])


def build_zeta_matrix(transformed_epochs, include_diagonal=True):
    """
    Build the zeta distance matrix between all pairs of epochs.
    """

    dates = sorted(transformed_epochs.keys())
    n_epochs = len(dates)

    zeta = np.zeros((n_epochs, n_epochs))

    for i in tqdm(range(n_epochs), desc="Computing zeta matrix"):
        matrix_i = transformed_epochs[dates[i]]

        for j in range(i, n_epochs):
            matrix_j = transformed_epochs[dates[j]]

            zeta_ij = calculate_zeta_between_matrices(
                matrix_a=matrix_i,
                matrix_b=matrix_j,
                include_diagonal=include_diagonal
            )

            zeta[i, j] = zeta_ij
            zeta[j, i] = zeta_ij

    zeta_matrix = pd.DataFrame(zeta, index=dates, columns=dates)
    zeta_matrix.to_csv(OUTPUT_DIR / "zeta_matrix.csv")

    return zeta_matrix


def validate_distance_matrix(distance_matrix):
    """
    Validate that a distance matrix is square, symmetric and non-negative.
    """

    values = distance_matrix.values.astype(float)

    assert values.shape[0] == values.shape[1], "Distance matrix must be square."
    assert np.allclose(values, values.T), "Distance matrix must be symmetric."
    assert np.all(values >= -1e-12), "Distance matrix must be non-negative."

    return True

def create_mds_model(n_components=2, random_state=RANDOM_STATE):
    """
    Create an MDS model.

    The try-except block keeps compatibility with different sklearn versions.
    """

    try:
        model = MDS(
            n_components=n_components,
            dissimilarity="precomputed",
            random_state=random_state,
            normalized_stress="auto",
            n_init=10
        )
    except TypeError:
        model = MDS(
            n_components=n_components,
            dissimilarity="precomputed",
            random_state=random_state,
            n_init=10
        )

    return model


def compute_mds_embedding(zeta_matrix, n_components=2):
    """
    Compute an MDS embedding from the zeta distance matrix.

    Important:
    zeta is already a distance matrix, so we do not use 1 - zeta.
    """

    validate_distance_matrix(zeta_matrix)

    distance_values = zeta_matrix.values.astype(float)
    distance_values = 0.5 * (distance_values + distance_values.T)
    np.fill_diagonal(distance_values, 0.0)

    mds_model = create_mds_model(
        n_components=n_components,
        random_state=RANDOM_STATE
    )

    coordinates = mds_model.fit_transform(distance_values)

    columns = [f"MDS{i + 1}" for i in range(n_components)]

    mds_embedding = pd.DataFrame(
        coordinates,
        index=zeta_matrix.index,
        columns=columns
    )

    mds_embedding.to_csv(OUTPUT_DIR / f"mds_{n_components}d_embedding.csv")

    return mds_embedding

def calculate_mean_intracluster_radius(coordinates, labels, centers):
    """
    Calculate the mean intra-cluster radius.

    For each cluster, compute the average distance from its points to its centroid.
    Then average those cluster radii.
    """

    cluster_radii = []

    for cluster_id in range(centers.shape[0]):
        cluster_points = coordinates[labels == cluster_id]

        if len(cluster_points) == 0:
            continue

        centroid = centers[cluster_id]
        distances = np.linalg.norm(cluster_points - centroid, axis=1)
        cluster_radii.append(np.mean(distances))

    if len(cluster_radii) == 0:
        return np.nan

    return np.mean(cluster_radii)


def run_single_kmeans(coordinates, n_clusters, random_state):
    """
    Run one K-Means clustering with a single initialization.
    """

    model = KMeans(
        n_clusters=n_clusters,
        init="k-means++",
        n_init=1,
        random_state=random_state
    )

    labels = model.fit_predict(coordinates)

    mean_radius = calculate_mean_intracluster_radius(
        coordinates=coordinates,
        labels=labels,
        centers=model.cluster_centers_
    )

    return labels, mean_radius


def evaluate_kmeans_stability(
    mds_embedding,
    min_k=2,
    max_k=10,
    n_runs=N_KMEANS_RUNS
):
    """
    Evaluate K-Means stability for different values of k.

    The criterion follows the idea of measuring the variation of
    intra-cluster distances across many random initial conditions.
    """

    coordinates = mds_embedding.values

    all_runs = []
    summary_records = []

    for k in tqdm(range(min_k, max_k + 1), desc="Evaluating k values"):
        radii = []

        for run_id in range(n_runs):
            _, mean_radius = run_single_kmeans(
                coordinates=coordinates,
                n_clusters=k,
                random_state=run_id
            )

            radii.append(mean_radius)

            all_runs.append({
                "k": k,
                "run_id": run_id,
                "mean_intracluster_radius": mean_radius
            })

        summary_records.append({
            "k": k,
            "mean_radius": np.mean(radii),
            "std_radius": np.std(radii)
        })

    all_runs_df = pd.DataFrame(all_runs)
    summary_df = pd.DataFrame(summary_records)

    all_runs_df.to_csv(OUTPUT_DIR / "kmeans_all_runs.csv", index=False)
    summary_df.to_csv(OUTPUT_DIR / "kmeans_stability_summary.csv", index=False)

    return all_runs_df, summary_df


def choose_k_by_minimum_std(summary_df):
    """
    Choose k by the minimum standard deviation of intra-cluster radius.
    """

    best_row = summary_df.loc[summary_df["std_radius"].idxmin()]
    optimal_k = int(best_row["k"])

    return optimal_k


def fit_final_kmeans(mds_embedding, n_clusters=N_MARKET_STATES):
    """
    Fit the final K-Means model using many initializations.
    """

    coordinates = mds_embedding.values

    model = KMeans(
        n_clusters=n_clusters,
        n_init=N_KMEANS_RUNS,
        random_state=RANDOM_STATE
    )

    clusters = model.fit_predict(coordinates)

    cluster_data = mds_embedding.copy()
    cluster_data["cluster"] = clusters

    cluster_data.to_csv(OUTPUT_DIR / "mds_kmeans_clusters_raw.csv")

    return model, cluster_data

def attach_epoch_metrics(cluster_data, epoch_metrics):
    """
    Attach average return, mean correlation and Gini information to MDS clusters.
    """

    enriched = cluster_data.join(epoch_metrics, how="left")
    enriched.to_csv(OUTPUT_DIR / "cluster_data_with_metrics.csv")

    return enriched


def build_cluster_order_by_mean_correlation(enriched_clusters):
    """
    Order clusters by mean market correlation.

    Low mean correlation corresponds to calm states.
    High mean correlation corresponds to critical states.
    """

    cluster_mean_correlation = (
        enriched_clusters
        .groupby("cluster")["mean_correlation"]
        .mean()
        .sort_values()
    )

    ordered_clusters = cluster_mean_correlation.index.tolist()

    cluster_to_state = {
        cluster_id: state_id + 1
        for state_id, cluster_id in enumerate(ordered_clusters)
    }

    return cluster_to_state, cluster_mean_correlation


def label_market_states(enriched_clusters):
    """
    Convert arbitrary K-Means clusters into ordered market states S1, S2, ..., Sk.
    """

    cluster_to_state, cluster_mean_correlation = build_cluster_order_by_mean_correlation(
        enriched_clusters=enriched_clusters
    )

    labeled = enriched_clusters.copy()

    labeled["state_id"] = labeled["cluster"].map(cluster_to_state)
    labeled["state_label"] = labeled["state_id"].apply(lambda x: f"S{x}")

    labeled = labeled.sort_index()
    labeled.to_csv(OUTPUT_DIR / "classified_market_states.csv")

    state_summary = (
        labeled
        .groupby("state_label")
        .agg(
            n_epochs=("state_id", "size"),
            mean_return=("average_return", "mean"),
            mean_correlation=("mean_correlation", "mean"),
            mean_gini=("correlation_gini", "mean")
        )
        .sort_values("mean_correlation")
    )

    state_summary.to_csv(OUTPUT_DIR / "market_state_summary.csv")

    print("Market state summary:")
    print(state_summary.round(4))

    return labeled, state_summary

def compute_transition_counts(classified_states):
    """
    Count transitions between consecutive market states.
    """

    state_labels = sorted(
        classified_states["state_label"].unique(),
        key=lambda x: int(x.replace("S", ""))
    )

    counts = pd.DataFrame(
        0,
        index=state_labels,
        columns=state_labels,
        dtype=int
    )

    sequence = classified_states["state_label"].tolist()

    for current_state, next_state in zip(sequence[:-1], sequence[1:]):
        counts.loc[current_state, next_state] += 1

    counts.to_csv(OUTPUT_DIR / "transition_counts.csv")

    return counts


def normalize_transition_counts(transition_counts):
    """
    Convert transition counts into row-normalized transition probabilities.
    """

    transition_matrix = transition_counts.div(
        transition_counts.sum(axis=1),
        axis=0
    ).fillna(0.0)

    transition_matrix.to_csv(OUTPUT_DIR / "transition_probability_matrix.csv")

    return transition_matrix


def compute_stationary_distribution(transition_matrix, n_steps=10000):
    """
    Compute the stationary distribution by power iteration.

    For a row-stochastic matrix P, the stationary distribution pi satisfies:
    pi = pi P.
    """

    P = transition_matrix.values.astype(float)
    n_states = P.shape[0]

    pi = np.ones(n_states) / n_states

    for _ in range(n_steps):
        pi_next = pi @ P

        if np.linalg.norm(pi_next - pi) < 1e-12:
            break

        pi = pi_next

    stationary = pd.Series(
        pi,
        index=transition_matrix.index,
        name="stationary_probability"
    )

    stationary.to_csv(OUTPUT_DIR / "stationary_distribution.csv")

    return stationary


def compute_empirical_state_frequencies(classified_states):
    """
    Compute observed frequencies of market states.
    """

    frequencies = (
        classified_states["state_label"]
        .value_counts(normalize=True)
        .sort_index()
        .rename("empirical_frequency")
    )

    frequencies.to_csv(OUTPUT_DIR / "empirical_state_frequencies.csv")

    return frequencies


def summarize_markov_results(classified_states, transition_matrix):
    """
    Compare empirical frequencies with stationary Markov probabilities.
    """

    empirical = compute_empirical_state_frequencies(classified_states)
    stationary = compute_stationary_distribution(transition_matrix)

    comparison = pd.concat([empirical, stationary], axis=1)
    comparison.to_csv(OUTPUT_DIR / "empirical_vs_stationary_probabilities.csv")

    print("Empirical vs stationary probabilities:")
    print(comparison.round(4))

    return comparison

def create_year_ticks(date_index, year_step=4):
    """
    Create tick positions and labels for date-indexed heatmaps.
    """

    tick_positions = []
    tick_labels = []
    last_year = None

    for i, date_value in enumerate(date_index):
        year = pd.Timestamp(date_value).year

        if year != last_year and year % year_step == 0:
            tick_positions.append(i)
            tick_labels.append(str(year))
            last_year = year

    return tick_positions, tick_labels

