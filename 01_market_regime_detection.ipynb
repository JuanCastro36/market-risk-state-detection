def get_latest_epoch_correlation(log_returns, window=WINDOW):
    """
    Compute the latest available rolling correlation matrix.
    """

    latest_returns = log_returns.iloc[-window:]
    latest_corr = latest_returns.corr()

    start_date = latest_returns.index[0]
    end_date = latest_returns.index[-1]

    return latest_corr, start_date, end_date


