def build_transition_network_graph(transition_matrix, min_probability=0.01):
    """
    Build a directed network from off-diagonal transition probabilities.

    Self-transitions are stored as node attributes instead of edges.
    """

    graph = nx.DiGraph()

    for state in transition_matrix.index:
        self_probability = transition_matrix.loc[state, state]
        graph.add_node(state, self_probability=self_probability)

    for source in transition_matrix.index:
        for target in transition_matrix.columns:
            probability = transition_matrix.loc[source, target]

            if source != target and probability >= min_probability:
                graph.add_edge(source, target, weight=probability)

    return graph


def plot_transition_network(
    transition_matrix,
    min_probability=0.01,
    filename="transition_network.png"
):
    """
    Plot the directed transition network.
    """

    graph = build_transition_network_graph(
        transition_matrix=transition_matrix,
        min_probability=min_probability
    )

    states = transition_matrix.index.tolist()
    angles = np.linspace(0, 2 * np.pi, len(states), endpoint=False)

    positions = {
        state: np.array([np.cos(angle), np.sin(angle)])
        for state, angle in zip(states, angles)
    }

    node_labels = {
        state: f"{state}\nself={transition_matrix.loc[state, state]:.3f}"
        for state in states
    }

    edge_widths = [
        1.0 + 8.0 * graph[u][v]["weight"]
        for u, v in graph.edges()
    ]

    edge_labels = {
        (u, v): f"{graph[u][v]['weight']:.3f}"
        for u, v in graph.edges()
    }

    plt.figure(figsize=(9, 7))
    ax = plt.gca()

    nx.draw_networkx_nodes(
        graph,
        positions,
        node_size=2600,
        edgecolors="black",
        linewidths=1.2,
        alpha=0.9,
        ax=ax
    )

    nx.draw_networkx_labels(
        graph,
        positions,
        labels=node_labels,
        font_size=9,
        font_weight="bold",
        ax=ax
    )

    nx.draw_networkx_edges(
        graph,
        positions,
        width=edge_widths,
        alpha=0.65,
        arrows=True,
        arrowsize=22,
        arrowstyle="->",
        connectionstyle="arc3,rad=0.15",
        min_source_margin=20,
        min_target_margin=20,
        ax=ax
    )

    nx.draw_networkx_edge_labels(
        graph,
        positions,
        edge_labels=edge_labels,
        font_size=9,
        rotate=False,
        bbox={
            "facecolor": "white",
            "edgecolor": "gray",
            "alpha": 0.85,
            "boxstyle": "round,pad=0.25"
        },
        ax=ax
    )

    plt.title("Directed Network of Market State Transitions")
    plt.axis("off")
    plt.tight_layout()

    path = OUTPUT_DIR / filename
    plt.savefig(path, dpi=300, bbox_inches="tight")
    plt.show()

    print(f"Saved figure: {path}")

def average_matrices(matrices):
    """
    Compute the element-wise average of several matrices.
    """

    values = np.stack([matrix.values for matrix in matrices], axis=0)
    mean_values = np.mean(values, axis=0)

    first_matrix = matrices[0]

    return pd.DataFrame(
        mean_values,
        index=first_matrix.index,
        columns=first_matrix.columns
    )


def compute_state_average_matrices(transformed_epochs, classified_states):
    """
    Compute one representative average correlation matrix per market state.
    """

    state_matrices = {}

    state_labels = sorted(
        classified_states["state_label"].unique(),
        key=lambda x: int(x.replace("S", ""))
    )

    for state_label in state_labels:
        dates = classified_states[classified_states["state_label"] == state_label].index

        matrices = []

        for date_value in dates:
            date_value = pd.Timestamp(date_value)

            if date_value in transformed_epochs:
                matrices.append(transformed_epochs[date_value])

        if len(matrices) > 0:
            state_matrices[state_label] = average_matrices(matrices)
            state_matrices[state_label].to_csv(
                OUTPUT_DIR / f"average_matrix_{state_label}.csv"
            )

    return state_matrices


